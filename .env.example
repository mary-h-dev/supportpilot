# Database
DATABASE_URL=postgresql+asyncpg://supportpilot:supportpilot@db:5432/supportpilot

# LLM (OpenRouter is OpenAI-compatible). Secrets ONLY from env.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Embeddings (Ollama, swappable)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
OLLAMA_URL=http://host.docker.internal:11434
