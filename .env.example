# Database
DATABASE_URL=postgresql+asyncpg://supportpilot:supportpilot@db:5432/supportpilot

# LLM (OpenRouter is OpenAI-compatible). Secrets ONLY from env.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Embeddings (Ollama, swappable)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
OLLAMA_URL=http://host.docker.internal:11434

# Cost estimate (USD per 1M tokens). Leave 0 for ':free' models.
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0
# Agent
AGENT_MIN_CONFIDENCE=0.6
AGENT_RETRIEVAL_K=5

# Shared key for /tickets* (send it as the X-API-Key header). Empty = auth disabled (dev only!)
API_KEY=
